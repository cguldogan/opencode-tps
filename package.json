{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-tps",
  "version": "1.0.0",
  "description": "OpenCode TUI statistics for main sessions and subagents",
  "type": "module",
  "exports": {
    ".": "./tui.tsx",
    "./tui": "./tui.tsx"
  },
  "files": [
    "README.md",
    "LICENSE",
    "tui.tsx",
    "tracker.ts",
    "tsconfig.json"
  ],
  "engines": {
    "opencode": ">=1.18.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tracker.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  }
}
